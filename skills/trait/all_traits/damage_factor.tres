base_value = 50.0
id = "damage_factor"
desc = "Damage multiplier, total damage is based on velocity."
dev_notes = "This damage factor does not directly correlate to damage dealt. The velocity has to be multiplied by a constant factor to make it more reasonable.

The damage exponent applies after this and causes damage to scale non-linearly with velocity."
